# EchoJudge AI Environment Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./echojudge.db
UPLOAD_DIR=./data/uploads
FEATURES_DIR=./data/features
REPORTS_DIR=./data/reports

# Optional Gemini Integration for enhanced natural language delivery coaching
# Leave empty to use deterministic explainable template coaching (zero cost, 100% offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
